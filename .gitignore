# Materiali personali e strumenti locali: restano sul computer.
.DS_Store
**/node_modules/
**/__pycache__/
*.py[cod]
/versioni/
/ricerca/
/supporto_locale/
/app/.tools/
/app/assets/
*.pdf
*.PDF

# Credenziali e chiavi private.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.aws/
.ssh/

# Dati grezzi e progetti personali di collaudo.
/app/benchmark/**/*.dat
/app/benchmark/**/*.log
/app/benchmark/editor/
/app/benchmark/phase6-demo/
/app/benchmark/rc-workflow/

# Guide distribuite; i registri storici restano in locale.
/docs/*
!/docs/USO_RAPIDO.md
!/docs/ANALISI_RC.md
!/docs/ANALISI_FREQUENZA.md
!/docs/FASE_2_MOTORE.md
